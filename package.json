{
  "name": "memes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pipeline determinista para producir Shorts verticales (1080x1920) desde una pagina HTML autocontenida.",
  "engines": { "node": ">=20" },
  "scripts": {
    "render": "node render.js",
    "render:caso1": "node render.js --caso 1",
    "render:caso2": "node render.js --caso 2",
    "render:caso3": "node render.js --caso 3",
    "publish": "node upload.js",
    "preview": "node -e \"console.log('Abre casos_icfes.html en tu navegador: file://'+require('path').resolve('casos_icfes.html'))\""
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "playwright": "^1.48.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
