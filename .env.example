# Copia este archivo a .env y rellena lo que necesites.
# .env está en .gitignore: nunca subas credenciales al repo.

# --- YouTube (alternativa a dejar client_secret.json en la raíz) ---
# Se obtienen creando un OAuth client de tipo "Aplicación de escritorio".
# Trámite completo en README.md → "Permisos de Google".
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# --- Binarios (solo si no están en el PATH) ---
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# --- Chromium (solo si no puedes correr `npx playwright install`) ---
# CHROMIUM_PATH=/ruta/a/chrome
